# Copie ce fichier en .env et remplace les deux secrets.
# Génère chacun avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Clé maître AES-256 (64 caractères hexadécimaux). Chiffre les clés Claude en base.
# Si tu la perds ou la changes, les clés stockées deviennent illisibles.
MASTER_KEY=

# Secret qui signe les liens de vidéo donnés à Instagram pendant une publication.
SERVER_SALT=

# Durée maximale d'une source, en heures.
MAX_SOURCE_HOURS=8

# Modèle de transcription faster-whisper : small (rapide) ou medium (plus précis, plus lent).
WHISPER_MODEL=small

# Modèle Claude utilisé pour repérer les meilleurs moments (vide = claude-opus-5-5).
# Moins cher : claude-sonnet-5-5 ou claude-haiku-5-5.
CLAUDE_MODEL=

# Facultatif : identifiants d'une application Twitch (gratuite, https://dev.twitch.tv/console/apps).
# Ils servent à lire les clips créés par les viewers sur une VOD. Sans eux, ce signal est ignoré.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Publication sur les réseaux (facultatif, voir « Applications développeur » dans le README) ---

# Adresse publique du site, sans barre finale. Elle sert aux retours de connexion des réseaux et à l'adresse
# que télécharge Instagram. TikTok et Instagram exigent une adresse https joignable depuis Internet.
APP_URL=http://localhost:3000

# YouTube : identifiants OAuth d'un projet Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok : application sur developers.tiktok.com (produits Login Kit et Content Posting API).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram : application Meta avec le produit Instagram (connexion Instagram pour les entreprises).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- Emails (facultatif) : mot de passe oublié et alerte d'échec de publication ---
# Format : smtp://utilisateur:motdepasse@hôte:587 (ou smtps://…:465). Vide : aucun email n'est envoyé.
SMTP_URL=
MAIL_FROM=ClipForge <no-reply@exemple.fr>

# Seulement pour lancer le web hors Docker (npm run dev dans web/) : copie aussi ce fichier en web/.env.
DATABASE_URL=postgresql://clipforge:clipforge@localhost:5432/clipforge
DATA_DIR=../data
