# Copie ce fichier en .env et remplace les deux secrets.
# Génère chacun avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Clé maître AES-256 (64 caractères hexadécimaux). Chiffre les clés Claude en base.
# Si tu la perds ou la changes, les clés stockées deviennent illisibles.
MASTER_KEY=

# Sel du hash qui identifie chaque utilisateur. Si tu le changes, plus personne ne retrouve son compte.
SERVER_SALT=

# Durée maximale d'une source, en heures.
MAX_SOURCE_HOURS=8

# Modèle de transcription faster-whisper : small (rapide) ou medium (plus précis, plus lent).
WHISPER_MODEL=small

# Modèle Claude utilisé pour repérer les meilleurs moments (vide = claude-opus-5-5).
# Moins cher : claude-sonnet-5-5 ou claude-haiku-5-5.
CLAUDE_MODEL=

# Facultatif : identifiants d'une application Twitch (gratuite, https://dev.twitch.tv/console/apps).
# Ils servent à lire les clips créés par les viewers sur une VOD. Sans eux, ce signal est ignoré.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Seulement pour lancer le web hors Docker (npm run dev dans web/) : copie aussi ce fichier en web/.env.
DATABASE_URL=postgresql://clipforge:clipforge@localhost:5432/clipforge
DATA_DIR=../data
